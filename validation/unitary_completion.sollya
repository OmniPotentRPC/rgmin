prec = 200!;
qcomponent = 1/2;
residual_first = 1/2;
residual_second = -1/2;
residual_squared = residual_first^2 + residual_second^2;
residual_norm = round(sqrt(residual_squared), 53, RN);
completed_first = round(residual_first/residual_norm, 53, RN);
completed_second = round(residual_second/residual_norm, 53, RN);
print("duplicate columns violate orthogonality: ", 4*qcomponent^2 == 1);
print("coordinate residual has positive squared norm: ", residual_squared == 1/2);
print("completed column is orthogonal in real part: ", qcomponent*(completed_first+completed_second) == 0);
print("completed column is orthogonal in imaginary part: ", -qcomponent*(completed_first+completed_second) == 0);
print("completed column has unit norm within four epsilons: ", abs(completed_first^2+completed_second^2-1) <= 4*2^(-52));
