prec = 200!;
raw_h0 = -2;
gradient_component = -1;
raw_direction = round(-raw_h0 * gradient_component, 53, RN);
safe_h0 = abs(raw_h0);
safe_direction = round(-safe_h0 * gradient_component, 53, RN);
cap_factor = 1/8;
capped_direction = round(cap_factor * safe_direction, 53, RN);
print("signed fallback is uphill: ", raw_direction * gradient_component > 0);
print("magnitude fallback has exact positive scale: ", safe_h0 == 2);
print("magnitude fallback is downhill: ", safe_direction * gradient_component < 0);
print("positive cap preserves descent: ", capped_direction * gradient_component < 0);
print("capped direction reaches the specified radius: ", abs(capped_direction) == 1/4);
